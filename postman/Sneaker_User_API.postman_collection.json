                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "0900000000",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "Địa chỉ kiểm thử",
                  "type": "text"
                },
                {
                  "key": "ward",
                  "value": "Phường 1",
                  "type": "text"
                },
                {
                  "key": "district",
                  "value": "Quận 1",
                  "type": "text"
                },
                {
                  "key": "city",
                  "value": "TP.HCM",
                  "type": "text"
                },
                {
                  "key": "role",
                  "value": "customer",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const username = pm.collectionVariables.get('user_name');",
                  "const marker = 'Sửa thông tin: ' + username;",
                  "const markerIndex = body.indexOf(marker);",
                  "pm.test('Tạo tài khoản thành công', () => { pm.response.to.have.status(200); pm.expect(body).to.include('Đã thêm tài khoản'); pm.expect(body).to.include(username); });",
                  "pm.test('Lấy được ID tài khoản vừa tạo cho các test tiếp theo', () => {",
                  "  pm.expect(markerIndex).to.be.above(-1);",
                  "  const matches = body.slice(0, markerIndex).match(/id=\"editModal\\d+\"/g) || [];",
                  "  pm.expect(matches.length).to.be.above(0);",
                  "  const id = matches[matches.length - 1].match(/\\d+/)[0];",
                  "  pm.collectionVariables.set('user_id', id);",
                  "});"
                ]
              }
            }
          ]
        },
