{
  "info": {
    "name": "Sneaker Shop - Test API Quản lý người dùng",
    "description": "Bộ kiểm thử Postman chức năng quản lý người dùng của Sneaker Shop. Chạy theo thứ tự: 0. Setup → 1. GET → 2. POST → 3. PUT → 4. DELETE. Lưu ý: admin/users.php là trang HTML, không phải REST API. GET dùng để đọc/lọc và khóa/mở khóa; POST hỗ trợ thêm/sửa/đặt lại mật khẩu. Source hiện chưa xử lý PUT hoặc DELETE; các request này kiểm tra rằng dữ liệu không bị thay đổi. Xem file TestCases_User_API.xlsx để biết test data, SQL và kết quả mong đợi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const cv = pm.collectionVariables;",
          "if (pm.info.requestName.indexOf('[S1]') === 0 || !cv.get('run_id')) {",
          "  cv.set('run_id', String(Date.now()).slice(-8));",
          "}",
          "const r = cv.get('run_id');",
          "cv.set('user_name', 'pm_user_' + r);",
          "cv.set('user_email', 'pm_user_' + r + '@example.com');",
          "cv.set('user_full_name', 'Postman Test ' + r);",
          "cv.set('user_full_name_updated', 'Postman Updated ' + r);",
          "cv.set('put_user_name', 'put_user_' + r);",
          "cv.set('unauth_user_name', 'unauth_user_' + r);",
          "cv.set('user_id', cv.get('user_id') || '');",
          "cv.set('seed_customer_id', '2');",
          "cv.set('seed_admin_id', '1');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/sneaker_shop"
    },
    {
      "key": "admin_user",
      "value": "admin"
    },
    {
      "key": "admin_pass",
      "value": "password"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "user_name",
      "value": ""
    },
    {
      "key": "user_email",
      "value": ""
    },
    {
      "key": "user_full_name",
      "value": ""
    },
    {
      "key": "user_full_name_updated",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "seed_customer_id",
      "value": "2"
    },
    {
      "key": "seed_admin_id",
      "value": "1"
    },
    {
      "key": "put_user_name",
      "value": ""
    },
    {
      "key": "unauth_user_name",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup (chuẩn bị phiên Admin)",
      "item": [
        {
          "name": "[S1] Admin login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/login.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login.php"
              ]
            },
            "description": "Đăng nhập Admin. Postman lưu cookie sneaker_admin_sess trong Cookie Jar.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{admin_pass}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login trả về 302', () => pm.response.to.have.status(302));",
                  "pm.test('Chuyển hướng đến admin/index.php', () => pm.expect(pm.response.headers.get('Location') || '').to.include('index.php'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "1. GET (đọc và lọc dữ liệu)",
      "item": [
        {
          "name": "TC-GET-01 | Admin xem danh sách tài khoản",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users.php"
              ]
            },
            "description": "Test data: dữ liệu seed admin id=1 và customer id=2. Steps: gửi GET và kiểm tra nội dung HTML danh sách."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "pm.test('HTTP 200 và hiển thị danh sách', () => { pm.response.to.have.status(200); pm.expect(body).to.include('Danh sách tài khoản'); });",
                  "pm.test('Có tài khoản seed Admin và khách hàng', () => { pm.expect(body).to.include('admin'); pm.expect(body).to.include('nguyenvana'); pm.expect(body).to.include('vana@email.com'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-GET-02 | Lọc chỉ tài khoản khách hàng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users.php?role=customer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users.php"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "customer"
                }
              ]
            },
            "description": "Test data: role=customer. Steps: gửi GET với query role=customer; đối chiếu tài khoản khách hàng và Admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "pm.test('HTTP 200 và có khách hàng', () => { pm.response.to.have.status(200); pm.expect(body).to.include('nguyenvana'); });",
                  "pm.test('Không hiển thị tài khoản Admin trong kết quả lọc', () => pm.expect(body).to.not.include('admin@sneakershop.vn'));"
                ]
              }
