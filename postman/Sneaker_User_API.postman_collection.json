            "description": "Test data: username/email sinh theo run_id; password Secret123; role customer. Steps: gửi form và lưu ID tài khoản từ HTML để dùng ở các test tiếp theo.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "action",
                  "value": "add",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{user_name}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Secret123",
                  "type": "text"
                },
                {
                  "key": "full_name",
                  "value": "{{user_full_name}}",
                  "type": "text"
                },
                {
                  "key": "email",
